{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elysium.prompt-modules/1",
  "title": "Elysium prompt modules, plain JSON, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "modules"
  ],
  "properties": {
    "format": {
      "const": "elysium.prompt-modules"
    },
    "version": {
      "const": 1
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "content"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24000,
            "pattern": "\\S"
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    }
  }
}

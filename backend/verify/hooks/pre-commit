#!/bin/sh
#
# Elysium pre-commit hook. THIS is the versioned copy; the one git runs lives
# at .git/hooks/pre-commit and is a copy of this file.
#
# That split is the whole reason this file exists. .git/hooks is not tracked,
# is not cloned, and is not restored from a backup of the repository, so a hook
# that lived only there would be absent on every fresh clone and its absence
# would look exactly like its presence: no diff, no failing test, no signal of
# any kind. So the source of truth is here, in the tree, and
# verify_hygiene.py compares what is installed against this file and reports a
# failure when they differ or when nothing is installed at all.
#
# To install or repair:
#     cp backend/verify/hooks/pre-commit .git/hooks/pre-commit
#
# Deliberately thin. Everything it knows is in run_gates.py, so changing what a
# lane runs does not mean reinstalling anything.
#
# This is the cheap lane. It runs the hygiene scanner over the index, checks
# that both installed hooks are the versioned ones, and runs the test files
# this commit is staging. The whole backend suite, the frontend suite and the
# exe build live in the pre-push hook beside it.
#
# Cheap is relative and the numbers are in run_gates.py: 0.2s when no test
# file is staged, about 2s for an ordinary one, and up to 38s for a commit
# that stages several slow ones. The under-two-seconds rule holds for
# the common case and not for every case; that is written down rather than
# rounded off.
#
# The index, not the working tree: at this moment the only content that
# matters is what is about to become a commit. The working tree may hold
# half-finished edits that are nobody's business yet.

set -e

for candidate in \
    backend/.venv/Scripts/python.exe \
    backend/.venv/bin/python \
    python3 \
    python
do
    if command -v "$candidate" >/dev/null 2>&1; then
        exec "$candidate" backend/verify/run_gates.py --hook pre-commit
    fi
done

# Reached only when no interpreter was found. Refuse rather than wave the
# commit through: a guard that fails open is a guard that reports nothing on
# exactly the machine where something is already misconfigured.
echo "pre-commit: no python interpreter found, cannot run the hygiene gate" >&2
echo "pre-commit: looked for backend/.venv, python3, python" >&2
exit 1

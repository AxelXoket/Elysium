{
  "temperature": 0.9,
  "impersonation_prompt": "Write as {{user}}.",
  "prompts": [
    {"identifier": "main", "name": "Main Prompt", "system_prompt": true, "role": "system",
     "content": "MAIN rules for the story.{{setvar::mood_on::}}{{setvar::diary_on::}}{{trim}}",
     "injection_position": 0, "injection_depth": 4},
    {"identifier": "style", "name": "Style", "role": "system",
     "content": "STYLE: short lines, present tense.", "injection_position": 0, "injection_depth": 4},
    {"identifier": "pace", "name": "Pacing (off)", "role": "system",
     "content": "PACE: slow burn.", "injection_position": 0, "injection_depth": 4},
    {"identifier": "mood_mod", "name": "Mood tracker", "role": "system",
     "content": "MOOD: track the mood.{{setvar::mood_on::yes}}", "injection_position": 0, "injection_depth": 4},
    {"identifier": "warmup", "name": "Warm up", "role": "assistant",
     "content": "WARMUP: I am ready to begin.", "injection_position": 0, "injection_depth": 4},
    {"identifier": "dialogueExamples", "name": "Chat Examples", "system_prompt": true, "marker": true},
    {"identifier": "chatHistory", "name": "Chat History", "system_prompt": true, "marker": true},
    {"identifier": "worldInfoBefore", "name": "World Info (before)", "system_prompt": true, "marker": true},
    {"identifier": "worldInfoAfter", "name": "World Info (after)", "system_prompt": true, "marker": true},
    {"identifier": "charDescription", "name": "Char Description", "system_prompt": true, "marker": true},
    {"identifier": "charPersonality", "name": "Char Personality", "system_prompt": true, "marker": true},
    {"identifier": "scenario", "name": "Scenario", "system_prompt": true, "marker": true},
    {"identifier": "personaDescription", "name": "Persona Description", "system_prompt": true, "marker": true},
    {"identifier": "state_a", "name": "State block", "role": "user",
     "content": "STATE: end your reply with a <state>...</state> block.", "injection_position": 1, "injection_depth": 0},
    {"identifier": "state_b", "name": "Diary", "role": "user",
     "content": "DIARY: keep a diary line.{{setvar::diary_on::yes}}", "injection_position": 1, "injection_depth": 0},
    {"identifier": "reader", "name": "Reader", "role": "user",
     "content": "READ: mood={{getvar::mood_on}} diary={{getvar::diary_on}}", "injection_position": 1, "injection_depth": 0},
    {"identifier": "think", "name": "Thinking (off)", "role": "user",
     "content": "THINK: plan first.", "injection_position": 1, "injection_depth": 0},
    {"identifier": "jailbreak", "name": "Post-History Instructions", "system_prompt": true, "role": "system",
     "content": "POST: stay in character.", "injection_position": 0, "injection_depth": 4},
    {"identifier": "loose", "name": "Debug tools", "role": "system",
     "content": "LOOSE: debug output.", "injection_position": 0, "injection_depth": 4}
  ],
  "prompt_order": [
    {"character_id": 100001, "order": [
      {"identifier": "main", "enabled": true},
      {"identifier": "style", "enabled": true},
      {"identifier": "pace", "enabled": false},
      {"identifier": "mood_mod", "enabled": true},
      {"identifier": "warmup", "enabled": true},
      {"identifier": "worldInfoBefore", "enabled": true},
      {"identifier": "personaDescription", "enabled": true},
      {"identifier": "charDescription", "enabled": true},
      {"identifier": "charPersonality", "enabled": true},
      {"identifier": "scenario", "enabled": true},
      {"identifier": "worldInfoAfter", "enabled": true},
      {"identifier": "dialogueExamples", "enabled": true},
      {"identifier": "chatHistory", "enabled": true},
      {"identifier": "state_a", "enabled": true},
      {"identifier": "state_b", "enabled": true},
      {"identifier": "reader", "enabled": true},
      {"identifier": "think", "enabled": false},
      {"identifier": "jailbreak", "enabled": true}
    ]}
  ],
  "extensions": {
    "regex_scripts": [
      {"id": "r1", "scriptName": "Strip old state", "findRegex": "/<state>[\\s\\S]*?<\\/state>/g",
       "replaceString": "", "trimStrings": [], "placement": [2], "disabled": false,
       "markdownOnly": false, "promptOnly": true, "runOnEdit": false, "substituteRegex": 0,
       "minDepth": 2, "maxDepth": null},
      {"id": "r2", "scriptName": "Color names", "findRegex": "/Mira/g",
       "replaceString": "<b>Mira</b>", "trimStrings": [], "placement": [2], "disabled": false,
       "markdownOnly": true, "promptOnly": false, "runOnEdit": false, "substituteRegex": 0,
       "minDepth": null, "maxDepth": null},
      {"id": "r3", "scriptName": "Fix typos", "findRegex": "/teh/g",
       "replaceString": "the", "trimStrings": [], "placement": [1], "disabled": false,
       "markdownOnly": false, "promptOnly": false, "runOnEdit": true, "substituteRegex": 0,
       "minDepth": null, "maxDepth": null}
    ]
  }
}
